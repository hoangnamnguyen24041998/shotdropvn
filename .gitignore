# =========================================================
# ShotDropVN — Root .gitignore
# Covers: Node.js, Expo (React Native), Next.js, Supabase, OS/IDE
# =========================================================

# ---------------------------------------------------------
# Environment variables & secrets (NEVER commit these)
# ---------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.mobileprovision
*.jks
*.keystore
!debug.keystore
google-services.json
GoogleService-Info.plist

# ---------------------------------------------------------
# Node.js
# ---------------------------------------------------------
node_modules/
jspm_packages/
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.stylelintcache
*.tsbuildinfo
coverage/
.nyc_output/
*.lcov
.cache/
.parcel-cache/
.turbo/

# ---------------------------------------------------------
# Expo / React Native (mobile/)
# ---------------------------------------------------------
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
*.orig.*

# Native folders generated by `npx expo prebuild`
/mobile/ios/
/mobile/android/

# iOS / Xcode
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/
DerivedData/
Pods/
*.ipa
*.dSYM.zip
*.dSYM

# Android / Gradle
.gradle/
local.properties
*.apk
*.aab
*.hprof
.cxx/
.externalNativeBuild/
.kotlin/

# Metro bundler
.metro-health-check*

# ---------------------------------------------------------
# Next.js (web/)
# ---------------------------------------------------------
.next/
out/
build/
next-env.d.ts
.vercel/
web/.live-store.json
web/public/uploads/

# ---------------------------------------------------------
# Supabase (be/)
# ---------------------------------------------------------
supabase/.branches/
supabase/.temp/
supabase/.env

# ---------------------------------------------------------
# Logs & temp files
# ---------------------------------------------------------
logs/
*.log
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# ---------------------------------------------------------
# OS files
# ---------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Linux
.directory
.Trash-*

# ---------------------------------------------------------
# IDE / Editor
# ---------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.sublime-workspace
*.sublime-project

# ---------------------------------------------------------
# ShotDrop runtime & APK artifacts
# ---------------------------------------------------------
web/.live-store.json
web/public/uploads/
web/public/*.apk
mobile/*.apk
mobile/android/build/
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/local.properties
